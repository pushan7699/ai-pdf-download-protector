# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=pdf_security
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-another-long-random-string
SESSION_TOKEN_EXPIRES_IN=15m

# ── CORS (set to your Vercel frontend URL) ────────────────────────────────────
CORS_ORIGIN=https://your-app.vercel.app

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage/private
MAX_FILE_SIZE=52428800

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── OpenAI (optional — enables AI-enhanced detection) ────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000

# ── Security thresholds ───────────────────────────────────────────────────────
LOW_RISK_THRESHOLD=30
MEDIUM_RISK_THRESHOLD=60
HIGH_RISK_THRESHOLD=80

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE_PATH=./logs
